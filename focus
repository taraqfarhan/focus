#!/usr/bin/env python3
import argparse
import json
import os
import random
import re
import signal
import string
import subprocess
import sys
import time

# --- Directory & File Path Setup ---
CONFIG_DIR = os.path.expanduser("~/.config/focus")
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.json")
STATE_PATH = os.path.join(CONFIG_DIR, "state.json")
HOSTS_PATH = "/etc/hosts"
HOSTS_MARKER_START = "# --- FOCUS BLOCK START ---"
HOSTS_MARKER_END = "# --- FOCUS BLOCK END ---"

os.makedirs(CONFIG_DIR, exist_ok=True)


# --- Custom Help String ---
CUSTOM_HELP = """
focus: block distracting apps and websites on macos

usage: focus [commands] [options] [duration]
       focus [blocklist commands] <App Name | Website URL>

       App Names should match the name of the app as it appears in the mac's Applications folder.
       So, App Names are Case Sensitive (It's WhatsApp, not Whatsapp)

       And Website URLs should be in the format of "example.com" (without "https://").


duration options:             10 (10 seconds), 10s (seconds), 2m (minutes), 5h (hours)

Commands:
  start [--hard <num>] <duration>   start the focus session (sudo required for websites)
  stop                              stop the active focus session (sudo required for websites)
  status                            check the status of the active focus session
  list                              list blocked apps and sites

Blocklist Management:
  add "App Name"              add an app to the blocklist
  remove "App Name"           remove an app from the blocklist
  add-site "Website URL"      add a website to the blocklist
  remove-site "Website URL"   remove a website from the blocklist

Options:
  --hard <num-of-chars>       require typing random chars to stop early
  -h, --help                  show this help message and exit
"""

# --- Configuration & State Management ---

def load_config():
    default_config = {"apps": [], "sites": []}
    if not os.path.exists(CONFIG_PATH):
        return default_config
    try:
        with open(CONFIG_PATH, 'r') as f:
            loaded = json.load(f)
            default_config.update(loaded)
            return default_config
    except Exception:
        return default_config


def save_config(config):
    with open(CONFIG_PATH, 'w') as f:
        json.dump(config, f, indent=4)


def save_state(pid, end_time, apps, sites, hard=0):
    state = {"pid": pid, "end_time": end_time, "apps": apps, "sites": sites, "hard": hard}
    with open(STATE_PATH, 'w') as f:
        json.dump(state, f)


def load_state():
    if not os.path.exists(STATE_PATH):
        return None
    try:
        with open(STATE_PATH, 'r') as f:
            return json.load(f)
    except Exception:
        return None


def clear_state():
    if os.path.exists(STATE_PATH):
        os.remove(STATE_PATH)


# --- Time Parsing ---

def parse_duration(duration_str):
    match = re.match(r"^(\d+)([smh]?)$", duration_str.lower())
    if not match:
        raise ValueError("Invalid duration format. Must be a positive integer optionally followed by 's', 'm', or 'h'.")
    num_str, suffix = match.groups()
    num = int(num_str)
    if num <= 0:
        raise ValueError("Duration must be a positive integer (greater than 0).")
    if suffix == 'm':
        return num * 60
    elif suffix == 'h':
        return num * 3600
    else:
        return num


# --- macOS Interfacing ---

def get_running_apps():
    """
    Retrieves currently running GUI application names using ps and lsappinfo.
    Avoids querying macOS 'System Events' via AppleScript, which causes IPC lockups
    and interferes with background accessibility apps like rcmd, Raycast, and Alfred.
    """
    apps = set()
    try:
        res = subprocess.run(["ps", "-ax", "-o", "comm="], capture_output=True, text=True)
        for line in res.stdout.splitlines():
            line = line.strip()
            if not line or ".appex/" in line or ".xpc/" in line:
                continue
            # Match main application bundles in /Applications or /System/Applications
            m = re.search(r"/(?:Applications|System/Applications)/([^/]+)\.app/Contents/MacOS/", line)
            if m:
                apps.add(m.group(1))
            else:
                m2 = re.search(r"/Applications/([^/]+)\.app/", line)
                if m2:
                    apps.add(m2.group(1))
    except Exception:
        pass

    try:
        res = subprocess.run(["lsappinfo", "list"], capture_output=True, text=True)
        for line in res.stdout.splitlines():
            if "bundle path=" in line:
                m = re.search(r"/(?:Applications|System/Applications)/([^/]+)\.app", line)
                if m:
                    apps.add(m.group(1))
            elif " ASN:" in line and "(hidden)" not in line:
                m = re.search(r"\"([^\"]+)\"", line)
                if m:
                    apps.add(m.group(1))
    except Exception:
        pass

    return apps


def kill_app(app_name):
    """
    Forcefully terminates the application to prevent it from running.
    Uses killall -9 to send SIGKILL, ensuring the app closes immediately.
    """
    subprocess.run(['killall', '-9', app_name], capture_output=True, text=True)


# --- Hosts File & DNS Management ---

def is_root():
    return os.geteuid() == 0


def flush_dns():
    subprocess.run(['dscacheutil', '-flushcache'], capture_output=True)
    subprocess.run(['killall', '-HUP', 'mDNSResponder'], capture_output=True)


def apply_hosts_block(sites):
    try:
        with open(HOSTS_PATH, "r") as f:
            content = f.read()
        if HOSTS_MARKER_START in content:
            return  # Already blocked

        block_lines = [HOSTS_MARKER_START]
        for site in sites:
            clean_site = site.replace("https://", "").replace("http://", "").split("/")[0]
            block_lines.append(f"127.0.0.1 {clean_site}")
            block_lines.append(f"127.0.0.1 www.{clean_site}")
        block_lines.append(HOSTS_MARKER_END)

        with open(HOSTS_PATH, "a") as f:
            f.write("\n" + "\n".join(block_lines) + "\n")
        flush_dns()
    except PermissionError:
        print("  Permission denied: Cannot modify /etc/hosts.")
        print("  Please run with sudo: sudo focus start <duration>")
        sys.exit(1)


def remove_hosts_block():
    try:
        with open(HOSTS_PATH, "r") as f:
            lines = f.readlines()

        new_lines = []
        in_block = False
        for line in lines:
            if line.strip() == HOSTS_MARKER_START:
                in_block = True
                continue
            elif line.strip() == HOSTS_MARKER_END:
                in_block = False
                continue
            if not in_block:
                new_lines.append(line)

        with open(HOSTS_PATH, "w") as f:
            f.writelines(new_lines)
        flush_dns()

    except PermissionError:
        print("  Permission denied: Cannot modify /etc/hosts.")
        print("  Please run with sudo: sudo focus stop")
        sys.exit(1)


def check_and_restart_browsers(sites):
    """Checks if any browser has a blocked site open. If so, restarts that browser."""
    # Clean the domains for matching (e.g., 'youtube.com' from 'https://www.youtube.com/feed')
    domains = [s.replace("https://", "").replace("http://", "").split("/")[0].replace("www.", "") for s in sites]
    browsers = ["Brave Browser", "Google Chrome", "Microsoft Edge", "Safari", "Vivaldi", "Arc", "Firefox", "Tor Browser"]
    running = get_running_apps()

    for browser in browsers:
        if browser not in running:
            continue

        # Fetch all open tab URLs from the browser
        url_script = f'''
        tell application "{browser}"
            set urlList to {{}}
            try
                repeat with w in windows
                    repeat with t in tabs of w
                        set end of urlList to (URL of t)
                    end repeat
                end repeat
            end try
            set AppleScript's text item delimiters to ","
            return urlList as string
        end tell
        '''
        try:
            res = subprocess.run(['osascript', '-e', url_script], capture_output=True, text=True, check=True)
            all_urls = res.stdout.lower()

            # Check if any blocked domain is in the tab URLs
            has_blocked_tab = any(d in all_urls for d in domains)

        except subprocess.CalledProcessError:
            # If AppleScript fails (e.g., Arc's non-standard dictionary), assume true to be safe
            has_blocked_tab = True

        # Firefox & Tor Browser do not expose tab URLs via AppleScript; restart if running when site blocks apply
        if browser in ["Firefox", "Tor Browser"]:
            has_blocked_tab = True

        # If a blocked tab is found, quit and reopen that specific browser
        if has_blocked_tab:
            print(f"  Blocked site check: Restarting {browser} to enforce site blocks...")

            quit_script = f'tell application "{browser}" to quit'
            subprocess.run(['osascript', '-e', quit_script], capture_output=True, text=True)

            time.sleep(1.5)  # Wait for the browser to fully close and drop connections

            open_script = f'do shell script "open -a \\"{browser}\\""'
            subprocess.run(['osascript', '-e', open_script], capture_output=True, text=True)


# --- Daemon Logic ---

def run_daemon(end_time_str, apps_str, sites_str):
    """Runs in the background. Kills apps until time expires, then restores hosts."""
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    signal.signal(signal.SIGINT, signal.SIG_IGN)

    devnull_r = open(os.devnull, 'r')
    devnull_w = open(os.devnull, 'a+')
    os.dup2(devnull_r.fileno(), sys.stdin.fileno())
    os.dup2(devnull_w.fileno(), sys.stdout.fileno())
    os.dup2(devnull_w.fileno(), sys.stderr.fileno())

    # Use arguments passed directly from the parent process
    end_time = float(end_time_str)
    app_list = apps_str.split('|') if apps_str else []
    site_list = sites_str.split('|') if sites_str else []

    while time.time() < end_time:
        running_apps = get_running_apps()
        for app in app_list:
            clean_app = app.replace(".app", "")
            if app in running_apps or clean_app in running_apps:
                kill_app(app)
        time.sleep(0.5)  # Checks twice per second using lightweight lookup

    # Time's up: restore websites and clean up
    if site_list:
        remove_hosts_block()
    clear_state()
    sys.exit(0)


# --- Command Handlers ---

def handle_start(args):
    state = load_state()
    if state:
        try:
            os.kill(state["pid"], 0)
            is_alive = True
        except ProcessLookupError:
            is_alive = False
        except PermissionError:
            # We don't have permission to signal it
            # it's running as root froma previous sudo
            is_alive = True

        if is_alive:
            remaining = state["end_time"] - time.time()
            mins, secs = divmod(int(remaining), 60)
            hours, mins = divmod(mins, 60)
            time_str = f"{hours}h {mins}m {secs}s" if hours > 0 else f"{mins}m {secs}s"
            print("  Error: A focus session is already active!")
            print(f"  Time remaining: {time_str}")
            print("  Run 'focus stop' to end it early.")
            sys.exit(1)
        else:
            clear_state()

    config = load_config()
    if not config["apps"] and not config["sites"]:
        print("  Error: Blocklist is empty. Add apps or sites first!")
        sys.exit(1)

    if config["sites"] and not is_root():
        print("  Error: Blocking websites requires modifying /etc/hosts.")
        print("  Please run with sudo: sudo focus start <duration>")
        sys.exit(1)

    hard_chars = getattr(args, 'hard', 0) or 0
    if hard_chars < 0:
        print("  Error: --hard must be a positive integer.")
        sys.exit(1)

    try:
        duration_secs = parse_duration(args.duration)
    except ValueError as e:
        print(f"Error: {e}")
        sys.exit(1)

    end_time = time.time() + duration_secs

    if config["sites"]:
        print("  Applying website blocks and restarting browsers...")
        apply_hosts_block(config["sites"])
        check_and_restart_browsers(config["sites"])


    # Re-launch as detached background process, passing data directly to avoid race conditions
    script_path = os.path.realpath(__file__)
    apps_str = "|".join(config["apps"])
    sites_str = "|".join(config["sites"])

    cmd = [
        sys.executable, script_path,
        "--daemon-run",
        str(end_time),
        apps_str,
        sites_str
    ]

    proc = subprocess.Popen(
        cmd,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        stdin=subprocess.DEVNULL,
        start_new_session=True
    )

    # Save state with the daemon's PID
    save_state(proc.pid, end_time, config["apps"], config["sites"], hard=hard_chars)

    print(f"\n  Focus session started in background for {args.duration} ({duration_secs} seconds).")
    if hard_chars > 0:
        print(f"  Hard Mode: Enabled ({hard_chars} chars required to stop early)")
    if config["apps"]:
        print(f"  Blocking Apps: {', '.join(config['apps'])}")
    if config["sites"]:
        print(f"  Blocking Sites: {', '.join(config['sites'])}")
    print("  (You can safely close this terminal. The lock will persist.)")
    print("  Run 'focus status' to check time, or 'focus stop' to end early.")
    sys.exit(0)


def handle_stop(args):
    state = load_state()
    if not state:
        print("  No active focus session found.")
        sys.exit(0)

    if state.get("sites") and not is_root():
        print("  Error: This session is blocking websites, which requires modifying /etc/hosts.")
        print("  Please stop it with: sudo focus stop")
        sys.exit(1)

    hard_chars = state.get("hard", 0)
    if hard_chars > 0:
        chars = string.ascii_letters + string.digits
        print(f"  Hard Mode Active! To stop early, enter the exact char you see in each iteration (total: {hard_chars} chars)\n")
        try:
            for i in range(hard_chars):
                random_char = random.choice(chars)
                print(" ", i + 1, random_char, end="\b")
                user_char = input()
                if user_char != random_char:
                    print("  Error: char mismatch. Focus session cannot be stopped early.")
                    sys.exit(1)
        except (KeyboardInterrupt, EOFError):
            print("\n  Cancelled. Focus session continues.")
            sys.exit(1)

    try:
        os.kill(state["pid"], signal.SIGTERM)
        print("  Focus session stopped.")
    except ProcessLookupError:
        print("  Session was already stopped. Cleaning up state file.")

    if state.get("sites"):
        remove_hosts_block()

    clear_state()
    sys.exit(0)


def handle_status(args):
    state = load_state()
    if not state:
        print("  No active focus session.")
        sys.exit(0)

    try:
        # Check if process is actually alive (send signal 0, which doesn't kill it)
        os.kill(state["pid"], 0)
    except ProcessLookupError:
        print("  Focus session crashed or stopped unexpectedly.")
        # If sites were involved, we need sudo to clean up /etc/hosts
        if state.get("sites"):
            if is_root():
                print("  Cleaning up website blocks...")
                remove_hosts_block()
                clear_state()
                print("  Cleanup complete.")
            else:
                print("  Error: This session was blocking websites. Requires sudo to clean up /etc/hosts.")
                print("  Please run: sudo focus status (or sudo focus stop)")
        else:
            clear_state()
            print("  Cleaned up state file.")
        sys.exit(0)

    except PermissionError:
        # The process is running as root, so we can't signal it.
        # But it IS alive!
        pass

    remaining = state["end_time"] - time.time()
    if remaining <= 0:
        print("  Focus session should be ending momentarily...")
        clear_state()
        sys.exit(0)

    mins, secs = divmod(int(remaining), 60)
    hours, mins = divmod(mins, 60)
    time_str = f"{hours}h {mins}m {secs}s" if hours > 0 else f"{mins}m {secs}s"

    print(f"  Focus session active.")
    print(f"  Time remaining: {time_str}")
    if state.get("hard"):
        print(f"  Hard Mode: Enabled ({state['hard']} chars required to stop early)")
    if state["apps"]:
        print(f"  Blocking Apps: {', '.join(state['apps'])}")
    if state["sites"]:
        print(f"  Blocking Sites: {', '.join(state['sites'])}")


# --- Main CLI ---

def main():
    # Use add_help=False so we can intercept and print our custom help page
    parser = argparse.ArgumentParser(
        description="Block distracting apps and websites on macos",
        add_help=False
    )

    # Hidden flags
    parser.add_argument("-h", "--help", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--daemon-run", nargs=3, metavar=('END', 'APPS', 'SITES'), help=argparse.SUPPRESS)

    subparsers = parser.add_subparsers(dest="command", metavar='<command>')

    parser_add = subparsers.add_parser("add", add_help=False)
    parser_add.add_argument("name", type=str)

    parser_remove = subparsers.add_parser("remove", add_help=False)
    parser_remove.add_argument("name", type=str)

    parser_add_site = subparsers.add_parser("add-site", add_help=False)
    parser_add_site.add_argument("url", type=str)

    parser_remove_site = subparsers.add_parser("remove-site", add_help=False)
    parser_remove_site.add_argument("url", type=str)

    subparsers.add_parser("list", add_help=False)

    parser_start = subparsers.add_parser("start", add_help=False)
    parser_start.add_argument("--hard", type=int, default=0)
    parser_start.add_argument("duration", type=str)

    subparsers.add_parser("stop", add_help=False)
    subparsers.add_parser("status", add_help=False)

    args = parser.parse_args()

    # Must handle daemon run first, before checking for missing commands
    if args.daemon_run:
        # Pass the arguments to the daemon function
        run_daemon(args.daemon_run[0], args.daemon_run[1], args.daemon_run[2])
        sys.exit(0)

    # Intercept help request or no command provided
    if args.help or not args.command:
        print(CUSTOM_HELP)
        sys.exit(0)


    config = load_config()

    if args.command == "add":
        if args.name not in config["apps"]:
            config["apps"].append(args.name)
            save_config(config)
            print(f"  Added app '{args.name}' to blocklist.")
        else:
            print(f"  App '{args.name}' is already in the blocklist.")

    elif args.command == "remove":
        if args.name in config["apps"]:
            config["apps"].remove(args.name)
            save_config(config)
            print(f"  Removed app '{args.name}' from blocklist.")
        else:
            print(f"  App '{args.name}' not found in blocklist.")

    elif args.command == "add-site":
        if args.url not in config["sites"]:
            config["sites"].append(args.url)
            save_config(config)
            print(f"  Added site '{args.url}' to blocklist.")
        else:
            print(f"  Site '{args.url}' is already in the blocklist.")

    elif args.command == "remove-site":
        if args.url in config["sites"]:
            config["sites"].remove(args.url)
            save_config(config)
            print(f"  Removed site '{args.url}' from blocklist.")
        else:
            print(f"  Site '{args.url}' not found in blocklist.")

    elif args.command == "list":
        print("  Blocked Apps:")
        if config["apps"]:
            for app in config["apps"]:
                print(f"    - {app}")
        else:
            print("    (none)")

        print("\n  Blocked Sites:")
        if config["sites"]:
            for site in config["sites"]:
                print(f"    - {site}")
        else:
            print("    (none)")

    elif args.command == "start":
        handle_start(args)

    elif args.command == "stop":
        handle_stop(args)

    elif args.command == "status":
        handle_status(args)


if __name__ == "__main__":
    main()
